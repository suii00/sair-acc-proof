import ACProof.AK1Distance
example : AC.runMoves (AC.AK 1) AC.AK1TwoConjugations = AC.standard 2 ∧ AC.conjCount AC.AK1TwoConjugations = 2 ∧ AC.AK1TwoConjugations.length = 9  := AC.AK1_twoConjugations_witness
example (ms : List (AC.PrimitiveMove 2)) (h : AC.runMoves (AC.AK 1) ms = AC.standard 2) : 9 ≤ ms.length := AC.AK1_distance_exact.2 ms h
example : AC.mulCount AC.AK1TwoConjugations = 5 := rfl
