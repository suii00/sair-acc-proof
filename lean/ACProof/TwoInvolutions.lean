import ACProof.ConjugationTrace
import ACProof.MillerSchupp
import Mathlib.Algebra.Group.Subgroup.Pointwise
import Mathlib.Algebra.Group.Conj

/-! # Two involutions and a lower bound on conjugation moves -/

namespace AC

variable {G : Type*} [Group G]

private theorem inv_of_square_one {s : G} (hs : s ^ 2 = 1) : s⁻¹ = s :=
  inv_eq_of_mul_eq_one_right (by simpa [pow_two] using hs)

/-- Normal form for the subgroup generated by two involutions. -/
private theorem involution_pair_normal_form {s t u : G} (hs : s ^ 2 = 1) (ht : t ^ 2 = 1)
    (hu : u ∈ Subgroup.closure ({s, t} : Set G)) :
    ∃ k : ℤ, u = (s * t) ^ k ∨ u = (s * t) ^ k * s := by
  let r := s * t
  let P (z : G) := ∃ k : ℤ, z = r ^ k ∨ z = r ^ k * s
  have hss : s * s = 1 := by simpa [pow_two] using hs
  have hrs : r⁻¹ * s = t := by simp [r, inv_of_square_one ht]
  have step : ∀ x y, y ∈ ({s, t} : Set G) → P x → P (x * y) := by
    intro x y hy hx
    rcases Set.mem_insert_iff.mp hy with rfl | hy
    · rcases hx with ⟨k, rfl | rfl⟩
      · exact ⟨k, Or.inr rfl⟩
      · exact ⟨k, Or.inl (by rw [mul_assoc, hss, mul_one])⟩
    · obtain rfl := Set.mem_singleton_iff.mp hy
      rcases hx with ⟨k, rfl | rfl⟩
      · exact ⟨k-1, Or.inr (by rw [zpow_sub, zpow_one, mul_assoc, hrs])⟩
      · exact ⟨k+1, Or.inl (by rw [zpow_add_one, mul_assoc])⟩
  change P u
  apply Subgroup.closure_induction_right (p := fun x _ => P x) _ _ _ hu
  · exact ⟨0, Or.inl (zpow_zero _).symm⟩
  · exact fun x _ y hy hx => step x y hy hx
  · intro x _ y hy hx
    have hy' : y⁻¹ = y := by
      rcases Set.mem_insert_iff.mp hy with rfl | hy
      · exact inv_of_square_one hs
      · obtain rfl := Set.mem_singleton_iff.mp hy
        exact inv_of_square_one ht
    rw [hy']
    exact step x y hy hx

private theorem square_is_rotation {s t u : G} (hs : s ^ 2 = 1) (ht : t ^ 2 = 1)
    (hu : u ∈ Subgroup.closure ({s, t} : Set G)) : ∃ k : ℤ, u ^ 2 = (s * t) ^ k := by
  let r := s * t
  have hsi := inv_of_square_one hs
  have hti := inv_of_square_one ht
  have hc : s * r * s⁻¹ = r⁻¹ := by
    simp [r, ← mul_assoc, ← pow_two, hs, hsi, hti]
  obtain ⟨k, hk | hk⟩ := involution_pair_normal_form hs ht hu
  · exact ⟨k+k, by rw [hk, pow_two, zpow_add]⟩
  · have hk' : s * r ^ k * s = (r ^ k)⁻¹ := by
      calc
        s * r ^ k * s = s * r ^ k * s⁻¹ := by rw [hsi]
        _ = (s * r * s⁻¹) ^ k := conj_zpow.symm
        _ = (r ^ k)⁻¹ := by rw [hc, inv_zpow]
    refine ⟨0, ?_⟩
    change (u ^ 2) = r ^ (0 : ℤ)
    rw [hk, pow_two, zpow_zero]
    change r ^ k * s * (r ^ k * s) = 1
    rw [mul_assoc, ← mul_assoc s, hk', mul_inv_cancel]

/-- All squares commute in any subgroup generated by two involutions, allowing either
involution to be the identity. -/
theorem commute_sq_of_mem_closure_involutions {s t u v : G}
    (hs : s ^ 2 = 1) (ht : t ^ 2 = 1)
    (hu : u ∈ Subgroup.closure ({s,t} : Set G)) (hv : v ∈ Subgroup.closure ({s,t} : Set G)) :
    Commute (u ^ 2) (v ^ 2) := by
  obtain ⟨i, hi⟩ := square_is_rotation hs ht hu
  obtain ⟨j, hj⟩ := square_is_rotation hs ht hv
  rw [hi, hj]
  exact (Commute.refl _).zpow_zpow i j

private def involutionSubgroup (s : G) (hs : s ^ 2 = 1) : Subgroup G where
  carrier := {z | z = 1 ∨ z = s}
  one_mem' := Or.inl rfl
  mul_mem' := by
    rintro x y (rfl | rfl) (rfl | rfl) <;> simp_all [← pow_two]
  inv_mem' := by
    rintro x (rfl | rfl) <;> simp [inv_of_square_one hs]

private def imagesIn {n : ℕ} (φ : Word n →* G) (H : Subgroup G) (R : Relators n) : Prop :=
  ∀ i, φ (R i) ∈ H

private theorem imagesIn_step {n : ℕ} (φ : Word n →* G) {H : Subgroup G} {R : Relators n}
    (m : PrimitiveMove n) (h : m.conjCost = 0) (hR : imagesIn φ H R) :
    imagesIn φ H (m.apply R) := by
  intro a
  cases m with
  | inv i =>
    by_cases ha : a = i
    · subst a
      simpa [PrimitiveMove.apply] using H.inv_mem (hR i)
    · simpa [PrimitiveMove.apply, Function.update_of_ne ha] using hR a
  | mulRight i j _ =>
    by_cases ha : a = i
    · subst a
      simpa [PrimitiveMove.apply] using H.mul_mem (hR i) (hR j)
    · simpa [PrimitiveMove.apply, Function.update_of_ne ha] using hR a
  | conj i w => contradiction

private theorem imagesIn_zero_conj {n : ℕ} (φ : Word n →* G) {H : Subgroup G} {R : Relators n}
    (ms : List (PrimitiveMove n)) (hm : conjCount ms = 0) (hR : imagesIn φ H R) :
    imagesIn φ H (runMoves R ms) := by
  induction ms generalizing R with
  | nil => exact hR
  | cons m ms ih =>
    obtain ⟨hm₁, hm₂⟩ := Nat.add_eq_zero_iff.mp hm
    exact ih hm₂ (imagesIn_step φ m hm₁ hR)

/-- After at most one conjugation, a relator tuple initially valued in `{1,s}`
is contained in the subgroup generated by `s` and another involution. -/
theorem exists_involutions_of_atMostOneConj {n : ℕ} (φ : Word n →* G) {s : G}
    (hs : s ^ 2 = 1) {R : Relators n} (hR : ∀ i, φ (R i) = 1 ∨ φ (R i) = s)
    (ms : List (PrimitiveMove n)) (hms : conjCount ms ≤ 1) :
    ∃ t : G, t ^ 2 = 1 ∧ ∀ i, φ (runMoves R ms i) ∈ Subgroup.closure ({s,t} : Set G) := by
  change imagesIn φ (involutionSubgroup s hs) R at hR
  induction ms generalizing R with
  | nil =>
    refine ⟨1, by simp, fun i => ?_⟩
    change φ (R i) ∈ _
    rcases hR i with h | h
    · rw [h]; exact Subgroup.one_mem _
    · rw [h]; exact Subgroup.subset_closure (by simp)
  | cons m ms ih =>
    cases m with
    | inv i =>
      exact ih (by simpa [conjCount, PrimitiveMove.conjCost] using hms)
        (imagesIn_step φ (.inv i) rfl hR)
    | mulRight i j hij =>
      exact ih (by simpa [conjCount, PrimitiveMove.conjCost] using hms)
        (imagesIn_step φ (.mulRight i j hij) rfl hR)
    | conj i w =>
      let t := φ w * s * (φ w)⁻¹
      let H := Subgroup.closure ({s,t} : Set G)
      have ht : t ^ 2 = 1 := by simp [t, conj_pow, hs]
      have hz : conjCount ms = 0 := by
        change 1 + conjCount ms ≤ 1 at hms
        omega
      refine ⟨t, ht, imagesIn_zero_conj φ ms hz (H := H) ?_⟩
      intro j
      by_cases hj : j = i
      · subst j
        rcases hR i with h | h
        · simp [PrimitiveMove.apply, h]
        · simpa [PrimitiveMove.apply, h, t] using
            (Subgroup.subset_closure (show t ∈ ({s,t} : Set G) by simp))
      · rcases hR j with h | h
        · simp [PrimitiveMove.apply, Function.update_of_ne hj, h]
        · simpa [PrimitiveMove.apply, Function.update_of_ne hj, h] using
            (Subgroup.subset_closure (show s ∈ ({s,t} : Set G) by simp))

/-- A quotient image can rule out all ordinary rank-two trivializations that use
at most one conjugation, with arbitrary ambient words allowed as conjugators. -/
theorem two_le_conjCount_of_involutionImage (φ : Word 2 →* G) {R : Relators 2}
    (h0 : φ (R 0) ^ 2 = 1) (h1 : φ (R 1) = 1)
    (hnc : ¬ Commute ((φ gx) ^ 2) ((φ gx * φ gy) ^ 2)) {ms : List (PrimitiveMove 2)}
    (hend : runMoves R ms = standard 2) : 2 ≤ conjCount ms := by
  by_contra! h
  have hi : ∀ i, φ (R i) = 1 ∨ φ (R i) = φ (R 0) := by
    intro i
    fin_cases i
    · exact Or.inr rfl
    · exact Or.inl h1
  obtain ⟨t, ht, hall⟩ := exists_involutions_of_atMostOneConj φ h0 hi ms (by omega)
  rw [hend] at hall
  exact hnc (commute_sq_of_mem_closure_involutions h0 ht (hall 0)
    (Subgroup.mul_mem _ (hall 0) (hall 1)))

end AC
