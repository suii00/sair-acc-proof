  exact s0.trans' (s1.trans' (s2.trans' (s3.trans' (s4.trans' (s5.trans' (s6.trans' (s7.trans' (s8.trans' (s9.trans' (s10.trans' (s11.trans' (s12.trans' (s13.trans' (s14.trans' (s15.trans' (s16.trans' (s17.trans' (s18.trans' (s19.trans' (s20.trans' (s21.trans' (s22.trans' (s23.trans' (s24.trans' (s25.trans' (s26.trans' (s27.trans' (s28.trans' (s29.trans' (s30.trans' (s31.trans' (s32.trans' (s33.trans' (s34.trans' (s35.trans' (s36.trans' (s37.trans' (s38.trans' (s39.trans' (s40.trans' (s41.trans' (s42.trans' (s43.trans' (s44.trans' (fin)))))))))))))))))))))))))))))))))))))))))))))

theorem MS3_wA_m10 : Reachable (MS 3 (wA (-10))) (standard 2) := by
  have h := MS_wA_reduce 3 (-3) (-1)
  rw [show (-3 : ℤ) * ((3 : ℕ) : ℤ) + -1 = -10 by norm_num] at h
  have e : MS 3 (gy ^ (-(-1 : ℤ)) * gx * gy ^ ((-1 : ℤ) - -3) * gx⁻¹) =
      ![(gx⁻¹ * gy * gy * gy * gx * gy⁻¹ * gy⁻¹ * gy⁻¹ * gy⁻¹), (gx * gx * gy⁻¹ * gy⁻¹ * gx⁻¹ * gy⁻¹)] := by
    ms_eq_tac
  rw [e] at h; exact h.trans' n3m10_path

theorem MS3_wA_m2 : Reachable (MS 3 (wA (-2))) (standard 2) := by
  have h := MS_wA_reduce 3 (-1) 1
  rw [show (-1 : ℤ) * ((3 : ℕ) : ℤ) + 1 = -2 by norm_num] at h
  have e : MS 3 (gy ^ (-(1 : ℤ)) * gx * gy ^ ((1 : ℤ) - -1) * gx⁻¹) =
      ![(gx⁻¹ * gy * gy * gy * gx * gy⁻¹ * gy⁻¹ * gy⁻¹ * gy⁻¹), (gx * gx * gy⁻¹ * gy⁻¹ * gx⁻¹ * gy)] := by
    ms_eq_tac
  rw [e] at h; exact h.trans' n3m2_path

theorem MS3_wA_m1 : Reachable (MS 3 (wA (-1))) (standard 2) := by
  have h := MS_wA_reduce 3 0 (-1)
  rw [show (0 : ℤ) * ((3 : ℕ) : ℤ) + -1 = -1 by norm_num] at h
  have e : MS 3 (gy ^ (-(-1 : ℤ)) * gx * gy ^ ((-1 : ℤ) - 0) * gx⁻¹) =
      ![(gx⁻¹ * gy * gy * gy * gx * gy⁻¹ * gy⁻¹ * gy⁻¹ * gy⁻¹), (gx * gx * gy * gx⁻¹ * gy⁻¹)] := by
    ms_eq_tac
  rw [e] at h; exact h.trans' n3m1_path

/-- `MS(3, y^{-m} x y^m x^{-1})` is AC-trivial whenever `m mod 12 ∉ {5, 7}`. -/
theorem MS3_wA (m : ℤ) (h5 : m % 12 ≠ 5) (h7 : m % 12 ≠ 7) :
    Reachable (MS 3 (wA m)) (standard 2) := by
  have hp := MS_wA_period_mul 3 m (-(m / 12))
  have e : m + -(m / 12) * ((((3 : ℕ) : ℤ) + 1) * ((3 : ℕ) : ℤ)) = m % 12 := by
    have := Int.emod_add_mul_ediv m 12; push_cast; linarith
  rw [e] at hp
  refine hp.trans' ?_
  have h0 : 0 ≤ m % 12 := Int.emod_nonneg m (by norm_num)
  have h1 : m % 12 < 12 := Int.emod_lt_of_pos m (by norm_num)
  generalize m % 12 = r at h0 h1 h5 h7 ⊢
  have mult : ∀ q : ℤ, Reachable (MS 3 (wA (q * 3))) (standard 2) := fun q => by
    simpa using MS_wA_mult 3 q
  have msucc : ∀ q : ℤ, Reachable (MS 3 (wA (q * 4))) (standard 2) := fun q => by
    have := MS_wA_mult_succ 3 q; norm_num at this; exact this
  have back : ∀ r : ℤ, Reachable (MS 3 (wA (r - 12))) (standard 2) →
      Reachable (MS 3 (wA r)) (standard 2) := fun r hr => by
    have := MS_wA_period_mul 3 r (-1)
    rw [show r + -1 * ((((3 : ℕ) : ℤ) + 1) * ((3 : ℕ) : ℤ)) = r - 12 by push_cast; ring] at this
    exact this.trans' hr
  interval_cases r
  · simpa using mult 0
  · exact MS_wA_one 3
  · exact back 2 (by simpa using MS3_wA_m10)
  · simpa using mult 1
  · simpa using msucc 1
  · exact absurd rfl h5
  · simpa using mult 2
  · exact absurd rfl h7
  · simpa using msucc 2
  · simpa using mult 3
  · exact back 10 (by simpa using MS3_wA_m2)
  · exact back 11 (by simpa using MS3_wA_m1)

end AC
